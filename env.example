# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# The group's chat id (negative number, e.g. -1001234567890).
# Get it by adding the bot to the group as admin and calling /getUpdates once,
# or by forwarding a group message to @userinfobot.
TELEGRAM_GROUP_ID=-1001234567890

# --- Patreon ---
# From https://www.patreon.com/portal/registration/register-clients
PATREON_ACCESS_TOKEN=your-creators-access-token
# Webhook signing secret, shown when you create the webhook in the Patreon portal
PATREON_WEBHOOK_SECRET=your-webhook-secret

# --- App ---
# Port the server listens on (webhook URL you give Patreon must point here)
PORT=3000
# How many days a membership grants group access for
MEMBERSHIP_DAYS=30
# How many minutes a one-time invite link stays valid for (time to click it)
INVITE_LINK_VALID_MINUTES=60
